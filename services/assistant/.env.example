# Store actual values only on the server, never commit them.
NODE_ENV=production
DEEPSEEK_API_KEY=
CHAT_IP_SECRET=
# User-approved model budget: CNY 10/month; conservative 8 CNY/USD.
# Values above 1.25 are rejected by the server.
CHAT_MONTHLY_BUDGET_USD=1.25
CHAT_ALLOWED_ORIGIN=https://chengbei.org
CHAT_DATA_DIR=/data
TURNSTILE_SECRET_KEY=
# Enable only behind a proxy that overwrites X-Real-IP, with no direct public access.
CHAT_TRUST_PROXY=0
PORT=8787
