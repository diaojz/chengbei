# Store actual values only on the server, never commit them.
NODE_ENV=production
DEEPSEEK_API_KEY=
CHAT_IP_SECRET=
# User-approved model budget: CNY 10/month; conservative 8 CNY/USD.
# Values above 1.25 are rejected by the server.
CHAT_MONTHLY_BUDGET_USD=1.25
CHAT_ALLOWED_ORIGIN=https://chengbei.org
CHAT_DATA_DIR=/data
TURNSTILE_SECRET_KEY=
# Enable only behind a proxy that overwrites X-Real-IP, with no direct public access.
CHAT_TRUST_PROXY=0
PORT=8787

# Prefer host secret-manager mounts. Use ONE form per secret, not both.
# DEEPSEEK_API_KEY_FILE=/run/secrets/deepseek_api_key
# CHAT_IP_SECRET_FILE=/run/secrets/chat_ip_secret
# TURNSTILE_SECRET_KEY_FILE=/run/secrets/turnstile_secret_key
# Mounted files must be owned/readable by service UID, permission 0400/0600.
