# Store actual values only on the server, never commit them.
NODE_ENV=production
DEEPSEEK_API_KEY=
CHAT_IP_SECRET=
# USD; explicit value required, no implicit paid operation.
CHAT_MONTHLY_BUDGET_USD=
CHAT_ALLOWED_ORIGIN=https://chengbei.org
CHAT_DATA_DIR=/data
TURNSTILE_SECRET_KEY=
# Enable only behind a proxy that overwrites X-Real-IP, with no direct public access.
CHAT_TRUST_PROXY=0
PORT=8787
