---
import '../styles/global.css';
import '../styles/product.css';
import '../styles/discovery.css';
import '../styles/studio.css';
import Search from '../components/Search.astro';
import VisitStats from '../components/VisitStats.astro';
import AskArticles from '../components/AskArticles.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: 'zh' | 'en';
  structuredData?: Record<string, unknown>;
  image?: string;
}

const {
  title = '城北 · 独立开发者',
  description = '城北的文章、项目与实践记录。',
  lang = 'zh',
  structuredData,
  image = '/assets/img/about-studio/workspace.webp'
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || 'https://chengbei.org').href;
const siteSchema = { '@context':'https://schema.org', '@type':'WebSite', '@id':'https://chengbei.org/#website', name:'城北', url:'https://chengbei.org/', inLanguage:['zh-CN','en'], author:{'@type':'Person','@id':'https://chengbei.org/#author',name:'城北',url:'https://chengbei.org/about/',sameAs:['https://github.com/diaojz']} };
const schemaJSON = JSON.stringify(structuredData || siteSchema).replace(/</g, '\\u003c');
const prefix = lang === 'en' ? '/en' : '';
const path = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const languageHref = lang === 'en' ? path : (/^\/(articles|projects|about|series)(\/|$)/.test(path) || path === '/' ? `/en${path}` : path.startsWith('/series/') ? '/en/articles/?topic=Dify' : '/en/projects/');
const current = (href: string) => href === '/' ? path === '/' : path.startsWith(href);

const labels = lang === 'zh'
  ? { home: '首页', learning: '系列', articles: '文章', projects: '项目', jobs: '岗位集锦', about: '关于', search: '搜索', skip: '跳到正文', classic: '经典布局' }
  : { home: 'Home', learning: 'Series', articles: 'Articles', projects: 'Projects', jobs: 'Job guide', about: 'About', search: 'Search', skip: 'Skip to content', classic: 'Classic' };
const navigation = [
  { href: prefix || '/', match: '/', label: labels.home, icon: 'home' },
  { href: `${prefix}/articles/`, match: '/articles/', label: labels.articles, icon: 'writing' },
  { href: `${prefix}/series/dify/`, match: '/series/', label: labels.learning, icon: 'book' },
  { href: `${prefix}/projects/`, match: '/projects/', label: labels.projects, icon: 'grid' },
  { href: `${prefix}/about/`, match: '/about/', label: labels.about, icon: 'user' }
];
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="site-version" content="site-reading-brand-20261019" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="author" content="城北" />
    <script type="application/ld+json" set:html={schemaJSON} />
    <meta name="theme-color" content="#f7f8fa" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fragment+Mono&family=Noto+Sans+SC:wght@300;400;500;600;700&family=Noto+Serif+SC:wght@600;700;900&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="48x48" href="/assets/brand/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body data-theme="light">
    <script is:inline>
      (() => {
        let theme = 'light';
        try { const saved = localStorage.getItem('chengbei-theme'); if (saved === 'light' || saved === 'dark') theme = saved; } catch {}
        document.body.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <a class="skip-link" href="#content">{labels.skip}</a>
    <header class="site-header" data-pagefind-ignore>
      <a class="brand" href={prefix || '/'} aria-label={lang === 'zh' ? '城北首页' : 'Chengbei home'}>
        <span class="brand-symbol" aria-hidden="true"><img src="/assets/brand/chengbei-logo.webp" alt="" width="40" height="40" /></span><span class="brand-mark">城北<span class="brand-domain">chengbei.org</span></span>
        <span class="brand-role">{lang === 'zh' ? '独立开发者' : 'Independent developer'}</span>
      </a>
      <button class="nav-action sidebar-search" type="button" data-search-open aria-haspopup="dialog"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span>{labels.search}</span><kbd>/</kbd></button>
      <span class="sidebar-label" aria-hidden="true">{lang === 'zh' ? '探索这座站' : 'EXPLORE'}</span>
      <nav class="site-nav" aria-label={lang === 'zh' ? '主导航' : 'Main navigation'}>
        {navigation.map((item) => <a href={item.href} aria-current={current(item.match) ? 'page' : undefined}><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {item.icon === 'home' && <path d="m3 10 9-7 9 7v10H3V10Zm6 10v-7h6v7" />}
          {item.icon === 'writing' && <path d="M14 4H4v16h16V10M12 12l1-4 6-6 3 3-6 6-4 1Z" />}
          {item.icon === 'book' && <path d="M12 5C9 3 5 3 2 4v15c3-1 7-1 10 1 3-2 7-2 10-1V4c-3-1-7-1-10 1Zm0 0v15" />}
          {item.icon === 'grid' && <path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z" />}
          {item.icon === 'user' && <><circle cx="12" cy="8" r="4" /><path d="M4 21v-2a8 8 0 0 1 16 0v2" /></>}
        </svg><span>{item.label}</span></a>)}
        <button class="nav-action mobile-search" type="button" data-search-open aria-haspopup="dialog"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span>{labels.search}</span><kbd>/</kbd></button>
      </nav>
      <div class="sidebar-note"><span class="sidebar-note-mark" aria-hidden="true">✳</span><p>{lang === 'zh' ? '边做，边记录。' : 'Build. Learn. Share.'}</p><a href="https://github.com/diaojz">GitHub <span aria-hidden="true">↗</span></a></div>
      <div class="header-actions">
        <a class="layout-switch" href="/classic/" data-layout-switch data-target-layout="classic">
          <span aria-hidden="true">◫</span>{labels.classic}
        </a>
        <a class="language-link" href={languageHref}>{lang === 'zh' ? 'EN' : '中'}</a>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label={lang === 'zh' ? '切换明暗主题' : 'Toggle light and dark theme'}>◐</button>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer" data-pagefind-ignore>
      <span>© {new Date().getFullYear()} 城北</span>
      <VisitStats lang={lang} />
      <span>{lang === 'zh' ? '我一个人写，也慢慢维护。' : 'Written and maintained by Chengbei.'}</span>
    </footer>
    <Search />
    <AskArticles lang={lang} />
    <script is:inline data-goatcounter="https://chengbei.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
    <script is:inline>
      (() => {
        const oldPost = /^#\/p\/([\w-]+)$/.exec(location.hash);
        if (oldPost) location.replace(`/articles/${oldPost[1]}/`);
        document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
          const next = document.body.dataset.theme === 'dark' ? 'light' : 'dark';
          document.body.dataset.theme = next;
          document.documentElement.style.colorScheme = next;
          try { localStorage.setItem('chengbei-theme', next); } catch {}
        });
      })();
    </script>
  </body>
</html>
