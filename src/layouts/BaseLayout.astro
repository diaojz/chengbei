---
import '../styles/global.css';
import '../styles/product.css';
import '../styles/discovery.css';
import Search from '../components/Search.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: 'zh' | 'en';
}

const {
  title = '城北 · 独立开发者',
  description = '城北的文章、项目与实践记录。',
  lang = 'zh'
} = Astro.props;
const prefix = lang === 'en' ? '/en' : '';
const path = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const languageHref = lang === 'en' ? path : (/^\/(articles|projects|about|series)(\/|$)/.test(path) || path === '/' ? `/en${path}` : path.startsWith('/series/') ? '/en/articles/?topic=Dify' : '/en/projects/');
const current = (href: string) => href === '/' ? path === '/' : path.startsWith(href);

const labels = lang === 'zh'
  ? { home: '首页', learning: '系列', articles: '文章', projects: '项目', jobs: '岗位集锦', about: '关于', search: '搜索', skip: '跳到正文', classic: '经典布局' }
  : { home: 'Home', learning: 'Series', articles: 'Articles', projects: 'Projects', jobs: 'Job guide', about: 'About', search: 'Search', skip: 'Skip to content', classic: 'Classic' };
const navigation = [
  { href: prefix || '/', match: '/', label: labels.home },
  { href: `${prefix}/articles/`, match: '/articles/', label: labels.articles },
  { href: `${prefix}/series/dify/`, match: '/series/', label: labels.learning },
  { href: `${prefix}/projects/`, match: '/projects/', label: labels.projects },
  { href: `${prefix}/about/`, match: '/about/', label: labels.about }
];
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="site-version" content="discovery-20261019" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta name="theme-color" content="#f7f8fa" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fragment+Mono&family=Noto+Sans+SC:wght@300;400;500;600;700&family=Noto+Serif+SC:wght@600;700;900&display=swap" rel="stylesheet" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><rect width=%2264%22 height=%2264%22 rx=%2214%22 fill=%22%23c45d2d%22/><text x=%2215%22 y=%2245%22 font-size=%2238%22 fill=%22white%22>C</text></svg>" />
    <title>{title}</title>
  </head>
  <body data-theme="light">
    <script is:inline>
      (() => {
        let theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        try { const saved = localStorage.getItem('chengbei-theme'); if (saved === 'light' || saved === 'dark') theme = saved; } catch {}
        document.body.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <a class="skip-link" href="#content">{labels.skip}</a>
    <header class="site-header" data-pagefind-ignore>
      <a class="brand" href={prefix || '/'} aria-label={lang === 'zh' ? '城北首页' : 'Chengbei home'}>
        <span class="brand-mark">CBEI</span>
        <span class="brand-role">{lang === 'zh' ? '独立开发者' : 'Independent developer'}</span>
      </a>
      <nav class="site-nav" aria-label={lang === 'zh' ? '主导航' : 'Main navigation'}>
        {navigation.map((item) => <a href={item.href} aria-current={current(item.match) ? 'page' : undefined}>{item.label}</a>)}
        <button class="nav-action" type="button" data-search-open aria-haspopup="dialog">⌕ <span>{labels.search}</span><kbd>/</kbd></button>
      </nav>
      <div class="header-actions">
        <a class="layout-switch" href="/classic/" data-layout-switch data-target-layout="classic">
          <span aria-hidden="true">◫</span>{labels.classic}
        </a>
        <a class="language-link" href={languageHref}>{lang === 'zh' ? 'EN' : '中'}</a>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label={lang === 'zh' ? '切换明暗主题' : 'Toggle light and dark theme'}>◐</button>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer" data-pagefind-ignore>
      <span>© {new Date().getFullYear()} 城北</span>
      <span>Built in public · chengbei.org</span>
    </footer>
    <Search />
    <script is:inline>
      (() => {
        const layoutKey = 'chengbei-layout';
        let savedLayout;
        try { savedLayout = localStorage.getItem(layoutKey); } catch {}
        if (location.pathname === '/' && savedLayout === 'classic') {
          location.replace('/classic/');
          return;
        }
        document.querySelector('[data-layout-switch]')?.addEventListener('click', () => {
          try { localStorage.setItem(layoutKey, 'classic'); } catch {}
        });
        const oldPost = /^#\/p\/([\w-]+)$/.exec(location.hash);
        if (oldPost) location.replace(`/articles/${oldPost[1]}/`);
        document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
          const next = document.body.dataset.theme === 'dark' ? 'light' : 'dark';
          document.body.dataset.theme = next;
          document.documentElement.style.colorScheme = next;
          try { localStorage.setItem('chengbei-theme', next); } catch {}
        });
      })();
    </script>
  </body>
</html>
