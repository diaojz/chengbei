---
const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'zh';
const zh = lang === 'zh';
const prefix = zh ? '' : '/en';
const suggestions = ['Dify', 'Codex', 'npm', 'AI Agent'];
const copy = lang === 'zh'
  ? { title: '搜索整座站点', placeholder: '想找点什么？', hint: '输入关键词，搜索文章正文、专题和课程', empty: '没有找到相关内容', loading: '正在搜索…', close: '关闭搜索' }
  : { title: 'Search the whole site', placeholder: 'What are you looking for?', hint: 'Search articles, features and courses', empty: 'No matching content', loading: 'Searching…', close: 'Close search' };
---
<dialog class="search-dialog" data-search-dialog aria-labelledby="search-title">
  <div class="search-panel">
    <div class="search-topline"><span id="search-title">{copy.title}</span><button type="button" data-search-close aria-label={copy.close}><span aria-hidden="true">×</span><small>ESC</small></button></div>
    <p class="search-intro">{zh ? '从一个问题，找到下一步。' : 'A question is a good place to start.'}</p>
    <label class="search-box"><span aria-hidden="true">⌕</span><input type="search" data-search-input aria-label={copy.title} placeholder={copy.placeholder} autocomplete="off" spellcheck="false" /></label>
    <p class="search-status" data-search-status>{copy.hint}</p>
    <div class="search-discover" data-search-discover>
      <div class="search-topics"><span>{zh ? '热门主题' : 'POPULAR TOPICS'}</span>{suggestions.map(topic => <button type="button" data-search-term={topic}>{topic}<span aria-hidden="true">↗</span></button>)}</div>
      <div class="search-picks-heading"><span>{zh ? '也可以从这里开始' : 'A FEW PLACES TO START'}</span><a href={`${prefix}/articles/`}>{zh ? '全部文章' : 'All articles'} →</a></div>
      <div class="search-picks">
        <a href={`${prefix}/series/dify/`}><img src="/assets/img/article-covers/dify-cloud-first-app.webp" alt="" width="720" height="480" loading="lazy" /><span><small>{zh ? '系列 · 10 篇指南' : 'SERIES · 10 GUIDES'}</small><b>{zh ? '从零开始学 Dify' : 'Dify, from zero'}</b><span>{zh ? '按章节，搭出自己的 AI 应用。' : 'Build your own AI app, chapter by chapter.'}</span></span><i aria-hidden="true">↗</i></a>
        <a href={`${prefix}/articles/npm-npx-node-explained/`}><img src="/assets/img/about-studio/workspace.webp" alt="" width="720" height="480" loading="lazy" /><span><small>{zh ? '工具入门' : 'EVERYDAY TOOLS'}</small><b>{zh ? '弄懂 npm 与 npx' : 'Understand npm & npx'}</b><span>{zh ? '把终端里的相似命令讲清楚。' : 'Make sense of those similar commands.'}</span></span><i aria-hidden="true">↗</i></a>
      </div>
    </div>
    <div class="search-results" data-search-results aria-live="polite"></div>
  </div>
</dialog>
<script is:inline define:vars={{ copy }}>
  (() => {
    const dialog = document.querySelector('[data-search-dialog]');
    const input = dialog?.querySelector('[data-search-input]');
    const results = dialog?.querySelector('[data-search-results]');
    const status = dialog?.querySelector('[data-search-status]');
    const discover = dialog?.querySelector('[data-search-discover]');
    let generation = 0;
    let pagefind;
    let timer;
    const escapeHtml = (value) => String(value || '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
    const open = () => { if (!dialog?.open) dialog?.showModal(); requestAnimationFrame(() => input?.focus()); };
    const close = () => dialog?.close();
    const loadPagefind = async () => {
      if (!pagefind) { const modulePath = '/pagefind/pagefind.js'; pagefind = await import(modulePath); await pagefind.init(); }
      return pagefind;
    };
    const search = async () => {
      const current = ++generation;
      const query = input?.value.trim();
      if (discover) discover.hidden = Boolean(query);
      if (!query) { results.innerHTML = ''; status.textContent = copy.hint; return; }
      status.textContent = copy.loading;
      try {
        const engine = await loadPagefind();
        const found = await engine.search(query);
        const data = await Promise.all(found.results.slice(0, 12).map((item) => item.data()));
        if (current !== generation) return;
        status.textContent = data.length ? `${data.length} ${document.documentElement.lang.startsWith('zh') ? '条结果' : 'results'}` : copy.empty;
        results.innerHTML = data.map((item, index) => `<a class="search-result" href="${escapeHtml(item.url)}"><span class="search-result-index">${String(index + 1).padStart(2, '0')}</span><span><b>${escapeHtml(item.meta?.title || item.url)}</b><small>${item.excerpt || ''}</small></span></a>`).join('');
      } catch (error) {
        if (current !== generation) return;
        console.warn('[search]', error);
        status.textContent = document.documentElement.lang.startsWith('zh') ? '搜索索引暂时不可用' : 'Search index is unavailable';
      }
    };
    document.querySelectorAll('[data-search-open]').forEach((button) => button.addEventListener('click', open));
    dialog?.querySelector('[data-search-close]')?.addEventListener('click', close);
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) close(); });
    input?.addEventListener('input', () => { ++generation; clearTimeout(timer); timer = setTimeout(search, 120); });
    dialog?.querySelectorAll('[data-search-term]').forEach(button => button.addEventListener('click', () => { clearTimeout(timer); input.value = button.dataset.searchTerm; search(); input.focus(); }));
    document.addEventListener('keydown', (event) => { const editing = /INPUT|TEXTAREA|SELECT/.test(document.activeElement?.tagName || ''); if (event.key === '/' && !editing) { event.preventDefault(); open(); } });
  })();
</script>
