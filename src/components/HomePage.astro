---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from './PostList.astro';
import { posts, series, type Lang } from '../lib/content';
import { projects, projectText } from '../data/projects';
import siteData from '../../content/data.json';
interface Props { lang?: Lang; }
const { lang = 'zh' } = Astro.props;
const zh = lang === 'zh';
const prefix = zh ? '' : '/en';
const dify = series.find((item) => item.id === 'dify');
const featured = projects.filter((project) => project.featured).slice(0, 3);
const topics = zh ? ['AI Agent', 'Dify', 'Codex', '实用指南', '产品与工程'] : ['AI Agent', 'Dify', 'Codex', 'Guide', 'Product & Engineering'];
const entries = [
  { number: '01', label: zh ? '从一个小问题开始' : 'START WITH A QUESTION', title: zh ? '工具入门' : 'Everyday tools', description: zh ? 'npm、npx、终端与 AI 编程工具，把不熟悉的概念逐个讲清。' : 'Understand npm, npx, terminals, and AI coding tools, one concept at a time.', href: `${prefix}/articles/npm-npx-node-explained/`, action: zh ? '读一篇入门指南' : 'Read a practical guide', icon: '>_', cover: '/assets/img/about-studio/workspace.webp' },
  { number: '02', label: zh ? '沿着路线慢慢学' : 'FOLLOW A LEARNING PATH', title: zh ? '从零开始学 Dify' : 'Dify, from zero', description: zh ? '从第一个 Chatflow 到知识库、Agent 与部署，十篇文章串成一条路。' : 'Ten connected guides, from your first Chatflow to RAG, agents, and deployment.', href: `${prefix}/series/dify/`, action: zh ? '查看完整路线' : 'Explore the series', icon: '↗', cover: '/assets/img/article-covers/dify-cloud-first-app.webp' },
  { number: '03', label: zh ? '带着目标做准备' : 'WORK TOWARD A GOAL', title: zh ? 'AI 岗位与面试' : 'AI roles & interviews', description: zh ? '看真实岗位需要交付什么，再准备能力、作品与面试表达。' : 'Explore what AI roles actually deliver, then prepare skills, projects, and interviews.', href: '/ai-jobs/', action: zh ? '进入岗位集锦' : 'Browse the job guide', icon: '◎', cover: '/assets/img/project-covers/jobs.webp' }
];
---
<BaseLayout title={zh ? '城北 · 独立开发者' : 'Chengbei · Independent Developer'} description={zh ? 'AI 开发、工具使用与产品实践。城北的文章、项目和学习路线。' : 'Articles, projects, and learning paths on AI development and building useful products.'} lang={lang}>
  <div class="product-shell discovery-home">
    <section class="home-welcome">
      <div class="welcome-copy">
        <span class="welcome-kicker"><i aria-hidden="true"></i>{zh ? '独立开发者 · 持续构建中' : 'INDEPENDENT DEVELOPER · BUILDING IN PUBLIC'}</span>
        <h1>{zh ? '你好，我是城北。' : 'Hi, I’m Chengbei.'}<br /><span>{zh ? '边做产品，边把经验写下来。' : 'I build, learn, and write.'}</span></h1>
        <p>{zh ? '这里记录 AI 开发、工具使用和产品实践。希望你带着一个问题来，带着一个能用的方法离开。' : 'Field notes on AI development, everyday tools, and making useful products. Come with a question. Leave with something you can use.'}</p>
        <div class="welcome-actions"><a class="primary-link" href={`${prefix}/articles/`}>{zh ? '逛逛文章' : 'Explore the writing'} <span aria-hidden="true">→</span></a><a href={`${prefix}/about/`}>{zh ? '认识一下我' : 'A little about me'} ↗</a></div>
      </div>
      <div class="welcome-note">
        <span class="note-label">THE OPEN NOTEBOOK</span><div class="note-art" aria-hidden="true"></div>
        <div class="note-caption"><span>{zh ? '记录，也是一种构建。' : 'Writing is part of building.'}</span><span>CB / 2026</span></div>
      </div>
    </section>

    <section class="start-section" aria-labelledby="start-title">
      <div class="start-heading"><h2 id="start-title">{zh ? '想从哪里开始？' : 'Where would you like to start?'}</h2><p>{zh ? '找答案，学工具，或为下一步做准备。' : 'Find an answer, learn a tool, or plan your next step.'}</p></div>
      <div class="entry-grid">{entries.map((entry) => <a class="entry-card" href={entry.href}><div class="entry-cover"><img src={entry.cover} alt="" width="720" height="480" loading="lazy" decoding="async" /></div><div class="entry-top"><span>{entry.number} / {entry.label}</span><b aria-hidden="true">{entry.icon}</b></div><h3>{entry.title}</h3><p>{entry.description}</p><span class="entry-action">{entry.action} <span aria-hidden="true">→</span></span></a>)}</div>
    </section>

    <div class="content-columns home-reading">
      <section class="product-section writing-section">
        <div class="product-section-head"><div><span class="section-kicker">LATEST NOTES</span><h2>{zh ? '最近写下的' : 'Fresh from the notebook'}</h2></div><a href={`${prefix}/articles/`}>{zh ? `全部 ${posts.length} 篇` : `All ${posts.length} articles`} →</a></div>
        <PostList items={posts.slice(0, 5)} lang={lang} />
      </section>
      <aside class="home-aside">
        <button class="home-search-card" type="button" data-search-open><span class="section-kicker">{zh ? '带着问题来？' : 'LOOKING FOR SOMETHING?'}</span><b>{zh ? '搜索站内内容' : 'Search the notebook'} <span aria-hidden="true">⌕</span></b><small>{zh ? '搜文章正文、专题和课程' : 'Articles, features, and courses'}<kbd>/</kbd></small></button>
        <div class="topics-panel"><span class="section-kicker">TOPICS</span><h2>{zh ? '按主题慢慢翻' : 'Browse a topic'}</h2><div>{topics.map((topic) => <a href={`${prefix}/articles/?topic=${encodeURIComponent(topic)}`}>{topic}<span aria-hidden="true"> ↗</span></a>)}</div></div>
        {dify && <a class="series-panel" href={`${prefix}/series/dify/`}><span class="section-kicker">LEARNING PATH</span><h2>{zh ? dify.title_zh : dify.title_en}</h2><p>{zh ? '不用在十个标签页之间来回找，按章节读完一套完整实践。' : 'One connected path, instead of ten tabs to keep track of.'}</p><ol><li>{zh ? '先搭出第一个应用' : 'Build your first application'}</li><li>{zh ? '接上知识库与工具' : 'Connect knowledge and tools'}</li><li>{zh ? '走向部署与生产' : 'Deploy and operate it'}</li></ol><div><span>{dify.slugs.length} {zh ? '篇指南' : 'guides'}</span><b>{zh ? '查看目录' : 'View chapters'} →</b></div></a>}
      </aside>
    </div>

    <section class="product-section">
      <div class="product-section-head"><div><span class="section-kicker">SELECTED WORK</span><h2>{zh ? '做过的一些东西' : 'A few things I’ve built'}</h2></div><a href={`${prefix}/projects/`}>{zh ? '全部项目' : 'All projects'} →</a></div>
      <div class="work-grid">{featured.map((project, index) => { const text = projectText(project, lang); return <a class="work-card" href={project.href} style={`--work-index:'0${index + 1}'`}><div class="work-cover"><img src={project.cover} alt="" loading="lazy" width="640" height="360" /><span>{zh ? project.kind : 'PROJECT'}</span></div><div class="work-copy"><h3>{text.title}</h3><p>{text.description}</p><div><time>{project.date}</time><b>{zh ? '看看项目' : 'Explore'} ↗</b></div></div></a>; })}</div>
    </section>
    {zh && <section class="quiet-gallery" aria-label="影像记录">{siteData.images.map((image) => <figure><img src={`/${image.url}`} alt={image.caption_zh} loading="lazy" /><figcaption>{image.caption_zh}</figcaption></figure>)}</section>}
  </div>
</BaseLayout>
