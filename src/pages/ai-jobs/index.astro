---
import BaseLayout from '../../layouts/BaseLayout.astro';
import jobsData from '../../../content/ai-jobs/index.json';

const { jobs, updated_at: updatedAt, methodology_zh: methodology } = jobsData;
const categories = [...new Set(jobs.map((job) => job.category))];
---

<BaseLayout title="面试岗位集锦 · 城北" description="以可复核公开招聘样本为基础的 AI 岗位研究与面试准备资料。">
  <section class="job-library-layout">
    <header class="job-library-head"><div><span>AI JOB LIBRARY</span><h1>面试岗位集锦</h1><p>用可复核的招聘样本，快速看懂岗位做什么、要求什么、面试会问什么。</p></div><dl><div><dt>已建档</dt><dd>{jobs.length}<small>/ 30</small></dd></div><div><dt>最后更新</dt><dd>{updatedAt}</dd></div></dl></header>
    <div class="jobs-index">
      <div class="jobs-directory"><b>岗位目录</b><em>搜索或按方向筛选</em></div>
      <div class="jobs-toolbar" aria-label="岗位筛选">
        <label>筛选岗位<input type="search" placeholder="搜索岗位、能力或方向" data-job-search /></label>
        <div class="job-filters">
          <button class="active" data-job-filter="">全部 {jobs.length}</button>
          {categories.map((category) => <button data-job-filter={category}>{category}</button>)}
        </div>
      </div>
      <div class="job-library-list">
        {jobs.map((job, index) => <a class="job-list-row" data-job-card data-category={job.category} data-search={`${job.title_zh} ${job.title_en} ${job.summary_zh}`} href={`/ai-jobs/${job.slug}/`}>
          <span class="job-list-no">{String(index + 1).padStart(2, '0')}</span><div class="job-list-art" style={job.thumbnail ? `background-image: url(${job.thumbnail})` : undefined} aria-hidden="true"></div><div><span class="job-list-category">{job.category}</span><h2>{job.title_zh}{job.abbreviation && <mark>{job.abbreviation}</mark>}<small>{job.title_en}</small></h2><p>{job.summary_zh}</p></div><div class="job-list-meta"><b>{job.status === 'published' ? `${job.sample_count} 条已去重样本` : job.sample_count ? `${job.sample_count} 条待复核样本` : '样本采集中'}</b><em>{job.status === 'published' ? '已完成' : '研究中'}</em></div><span class="job-list-arrow">→</span>
        </a>)}
      </div>
      <p class="jobs-empty" hidden>没有匹配的岗位。试试“产品”“工程”或英文简称。</p>
      <aside class="job-library-aside"><b>怎么使用</b><ol><li>先按目标方向筛选岗位。</li><li>打开详情，优先读 JD 高频要求。</li><li>将自己的项目证据对照面试深挖项。</li></ol><div id="method"><b>统计口径</b><p>{methodology}</p></div></aside>
    </div>
  </section>
  <script>
    const search = document.querySelector<HTMLInputElement>('[data-job-search]');
    const filters = document.querySelectorAll<HTMLButtonElement>('[data-job-filter]');
    const cards = document.querySelectorAll<HTMLElement>('[data-job-card]');
    const empty = document.querySelector<HTMLElement>('.jobs-empty');
    let category = '';
    function update() {
      const keyword = search?.value.trim().toLowerCase() || '';
      let visible = 0;
      cards.forEach((card) => { const show = (!category || card.dataset.category === category) && (!keyword || card.dataset.search?.toLowerCase().includes(keyword)); card.hidden = !show; if (show) visible++; });
      if (empty) empty.hidden = visible > 0;
    }
    search?.addEventListener('input', update);
    filters.forEach((filter) => filter.addEventListener('click', () => { category = filter.dataset.jobFilter || ''; filters.forEach((item) => item.classList.toggle('active', item === filter)); update(); }));
  </script>
</BaseLayout>
