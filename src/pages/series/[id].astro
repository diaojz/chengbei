---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import SeriesOverview from '../../components/SeriesOverview.astro';
import { posts, series } from '../../lib/content';
export function getStaticPaths() { return series.map((item) => ({ params: { id: item.id }, props: { item } })); }
const { item } = Astro.props;
const items = item.slugs
  .map((slug: string) => posts.find((post) => post.slug === slug))
  .filter((post): post is (typeof posts)[number] => Boolean(post));
---
<BaseLayout title={`${item.title_zh} · 城北`} description={item.desc_zh}>
  <SeriesOverview item={item} items={items} />
  <section class="shell series-index"><PostList series items={items} /></section>
</BaseLayout>
