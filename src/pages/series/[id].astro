---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import VisualHeading from '../../components/VisualHeading.astro';
import { posts, series } from '../../lib/content';
export function getStaticPaths() { return series.map((item) => ({ params: { id: item.id }, props: { item } })); }
const { item } = Astro.props;
const items = item.slugs
  .map((slug: string) => posts.find((post) => post.slug === slug))
  .filter((post): post is (typeof posts)[number] => Boolean(post));
---
<BaseLayout title={`${item.title_zh} · 城北`} description={item.desc_zh}>
  <VisualHeading eyebrow={`SERIES · ${items.length}`} title={item.title_zh} description={item.desc_zh} variant="dify" mark="01 → 10 · FROM ZERO TO PRODUCTION" />
  <section class="shell series-index"><PostList items={items} /></section>
</BaseLayout>
