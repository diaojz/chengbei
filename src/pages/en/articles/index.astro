import PostList from '../../../components/PostList.astro';
import VisualHeading from '../../../components/VisualHeading.astro';
import { posts } from '../../../lib/content';
---
<BaseLayout title="Articles · Chengbei" description="Essays, practical guides and learning series by Chengbei." lang="en">
  <VisualHeading eyebrow={`WRITING · ${posts.length}`} title="Articles" description="Essays, guides and learning series, in one place." />
  <section class="shell article-index"><PostList items={posts} lang="en" /></section>
</BaseLayout>
