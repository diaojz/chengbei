{
  "name": "chengbei-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/copy-legacy.mjs && node scripts/write-discovery.mjs && pagefind --site dist && node scripts/check-secrets.mjs --dist",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "check": "astro check && npm test",
    "secret:scan": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/rss": "4.0.19",
    "astro": "7.3.2",
    "marked": "18.0.12",
    "pagefind": "1.5.2",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "22.20.2"
  }
}
